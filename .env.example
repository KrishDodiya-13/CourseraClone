# Copy to .env.local and fill in your own values. Never commit .env.local.
# Nothing in this file is a real credential.

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Coursera"

# --- Database (required from Phase 3) --------------------------------------
# Point this at your own PostgreSQL instance. Two common options:
#
#   1. The Docker Compose service in this repo (host port set by POSTGRES_PORT,
#      default 5434 because 5432/5433 are often taken by local installs):
#      DATABASE_URL="postgresql://lumen:YOUR_PASSWORD@localhost:5434/lumen?schema=public"
#      ...and set POSTGRES_PASSWORD below to the same value.
#
#   2. A PostgreSQL server you already run (default port 5432):
#      DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lumen?schema=public"
#
DATABASE_URL=

# --- Docker Compose ---------------------------------------------------------
# Only read by docker-compose.yml. Choose your own; it is local-only.
POSTGRES_USER="lumen"
POSTGRES_PASSWORD=
POSTGRES_DB="lumen"
POSTGRES_PORT="5434"

# --- Development seed -------------------------------------------------------
# Shared password for every seeded account. Development only — these accounts
# do not exist in any deployed environment.
SEED_USER_PASSWORD="coursera-dev-only-password"

# --- Authentication (required from Phase 4) --------------------------------
# Signs and encrypts the session JWT. Generate your own:
#   openssl rand -base64 32
# Rotating this invalidates every existing session.
AUTH_SECRET=

# Google OAuth. Both values are required for the provider to be registered;
# leaving them blank is valid and simply disables the "Continue with Google"
# button. Create credentials at https://console.cloud.google.com/apis/credentials
# with redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Canonical origin. Optional but recommended in production: setting it means
# Auth.js never derives callback URLs from the (spoofable) Host header.
#   AUTH_URL="https://your-domain.example"

# --- Payments (Phase 14) ----------------------------------------------------
# Stripe. Absent means the provider is simply not offered — nothing here is a
# real credential, and none is invented anywhere in the codebase.
# Get yours at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# From https://dashboard.stripe.com/webhooks — used to verify webhook
# signatures. A webhook endpoint without this is a way to grant free courses.
STRIPE_WEBHOOK_SECRET=

# Local sandbox provider signing key. Development only; falls back to
# AUTH_SECRET if unset. This is NOT a payment credential.
SANDBOX_WEBHOOK_SECRET=
